{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillsmith.tech/schemas/descale-tune-report.schema.json",
  "title": "Descale tune report",
  "description": "Output of the tune node (tune-skill): one entry per regression ID handled in this round.",
  "type": "object",
  "required": ["run_id", "round", "baseline_sha", "results"],
  "additionalProperties": false,
  "properties": {
    "run_id": {"type": "string", "pattern": "^[0-9]{8}-[0-9]{4}(-[0-9]+)?$"},
    "round": {"type": "integer", "minimum": 1, "maximum": 3},
    "baseline_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "skill",
          "repo",
          "branch",
          "base_sha",
          "new_head_sha",
          "status",
          "behavior_changed",
          "files_changed",
          "commit",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^R[0-9]+$"},
          "skill": {"type": "string", "minLength": 1},
          "repo": {"type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$"},
          "branch": {"type": "string", "minLength": 1},
          "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "new_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "status": {"enum": ["fixed", "wont_fix", "escalate"]},
          "behavior_changed": {"type": "boolean"},
          "files_changed": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$"},
          "note": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
